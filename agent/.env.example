# OpenAI
OPENAI_API_KEY=
OPENAI_REFLECT_MODEL=gpt-4o
# "realtime" for OpenAI Realtime API (voice-native), "classic" for STT+LLM+TTS pipeline
OPENAI_MODEL_TYPE=realtime
# Only used if OPENAI_MODEL_TYPE=classic
OPENAI_MODEL=gpt-4o
TTS_VOICE=echo

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Interhuman (server-side, for real-time signal detection from LiveKit video tracks)
INTERHUMAN_API_KEY=

# LemonSlice avatar (BOTH required to render Garry's avatar — otherwise audio-only)
# LEMONSLICE_API_KEY = the secret key (sk_lemon_...), sent as X-API-Key
# LEMON_SLICE_AVATAR_ID = the agent/avatar id (agent_...)
LEMONSLICE_API_KEY=
LEMON_SLICE_AVATAR_ID=

# Set to "true" only if the frontend publishes the user's camera to the LiveKit
# room. By default analysis runs via the browser → stream-proxy path instead.
AGENT_VIDEO_ANALYSIS=false
